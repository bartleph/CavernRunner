// cavern.rc - the program's icon and version information
//
// Dev-C++ compiles this with windres and builds it into Cavern.exe.
// The version information is what Windows shows under
// Properties -> Details when you right-click the .exe.

#include <windows.h>

1 ICON "cavern.ico"

1 VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0"                // UK English, Unicode
        BEGIN
            VALUE "FileDescription",  "Cavern Runner - a Manic Miner style platform game"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "Cavern"
            VALUE "OriginalFilename", "Cavern.exe"
            VALUE "ProductName",      "Cavern Runner"
            VALUE "ProductVersion",   "1.3"
            VALUE "LegalCopyright",   "Written in Dev-C++"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
